<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    tools:context=".ui.fragments.ScheduleFragment"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/eventify_surface"
    app:cardCornerRadius="22dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/eventify_outline"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="108dp"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvItemScheduleHour"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/schedule_item_time"
            android:textColor="@color/ColorPrimaryDark"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="09:00" />

        <TextView
            android:id="@+id/tvItemScheduleAMPM"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="@string/schedule_item_ampm"
            android:textColor="@color/ColorPrimaryDark"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tvItemScheduleHour"
            app:layout_constraintTop_toBottomOf="@id/tvItemScheduleHour"
            tools:text="AM" />

        <View
            android:id="@+id/vScheduleDivider"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="14dp"
            android:background="@color/eventify_outline"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ivScheduleType"
            app:layout_constraintStart_toEndOf="@id/tvItemScheduleHour"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:id="@+id/ivScheduleType"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_icon_blue"
            app:layout_constraintStart_toEndOf="@id/vScheduleDivider"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/schedule_detail_main_icon"
                android:src="@drawable/ic_eventify_code"
                app:tint="@color/ColorPrimaryDark" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvItemScheduleTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/schedule_item_title"
            android:textColor="@color/eventify_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivScheduleType"
            app:layout_constraintTop_toTopOf="@id/ivScheduleType"
            tools:text="Keynote: El futuro del Desarrollo M&#243;vil" />

        <TextView
            android:id="@+id/tvItemScheduleSpeaker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/schedule_item_speaker"
            android:textColor="@color/eventify_text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="@id/tvItemScheduleTitle"
            app:layout_constraintStart_toStartOf="@id/tvItemScheduleTitle"
            app:layout_constraintTop_toBottomOf="@id/tvItemScheduleTitle"
            tools:text="Maria Gonz&#225;lez" />

        <TextView
            android:id="@+id/tvItemSchedulePlace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_chip_primary"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/schedule_item_place"
            android:textColor="@color/ColorPrimaryDark"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tvItemScheduleTitle"
            app:layout_constraintTop_toBottomOf="@id/tvItemScheduleSpeaker"
            tools:text="Auditorio Principal" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
