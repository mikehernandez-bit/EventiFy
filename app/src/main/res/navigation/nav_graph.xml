<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navHomeFragment">

    <fragment
        android:id="@+id/navHomeFragment"
        android:name="com.moviles.eventify.ui.fragments.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_scheduleFragment"
            app:destination="@id/navScheduleFragment" />
    </fragment>
    <fragment
        android:id="@+id/navScheduleFragment"
        android:name="com.moviles.eventify.ui.fragments.ScheduleFragment"
        android:label="fragment_schedule"
        tools:layout="@layout/fragment_schedule" >
        <action
            android:id="@+id/action_scheduleFragment_to_speakerFragment"
            app:destination="@id/navSpeakerFragment" />
        <action
            android:id="@+id/action_navScheduleFragment_to_scheduleDetailDialogFragment"
            app:destination="@id/scheduleDetailDialogFragment" />
    </fragment>
    <fragment
        android:id="@+id/navSpeakerFragment"
        android:name="com.moviles.eventify.ui.fragments.SpeakerFragment"
        android:label="fragment_speaker"
        tools:layout="@layout/fragment_speaker" >
        <action
            android:id="@+id/action_speakerFragment_to_ubicationFragment"
            app:destination="@id/navMapFragment" />
        <action
            android:id="@+id/action_navSpeakerFragment_to_speakerDetailDialogFragment"
            app:destination="@id/speakerDetailDialogFragment" />
    </fragment>
    <fragment
        android:id="@+id/navMapFragment"
        android:name="com.moviles.eventify.ui.fragments.UbicationFragment"
        android:label="fragment_ubication"
        tools:layout="@layout/fragment_ubication" />

    <dialog
        android:id="@+id/speakerDetailDialogFragment"
        android:name="com.moviles.eventify.ui.fragments.SpeakerDetailDialogFragment"
        android:label="SpeakerDetailDialogFragment"
        tools:layout="@layout/fragment_speaker_detail_dialog" />

    <dialog
        android:id="@+id/scheduleDetailDialogFragment"
        android:name="com.moviles.eventify.ui.fragments.ScheduleDetailDialogFragment"
        android:label="ScheduleDetailDialogFragment"
        tools:layout="@layout/fragment_schedule_detail_dialog" />

</navigation>